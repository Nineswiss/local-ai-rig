# Open WebUI's Python venv, created by setup-pc.ps1 on the PC. Hundreds of
# MB, machine-specific, never belongs in version control.
.openwebui-venv/

# Generated by running image-gate.py directly with the system Python.
__pycache__/

# Open WebUI API key for gpu-banner-watcher.ps1 - a credential, never
# commit it. See README's GPU-busy indicator section for how to get one.
.openwebui-api-key

# Root PID of the running gpu-banner-watcher.ps1, written by start-pc.ps1.
.gpu-banner-watcher.pid

# Its output, for debugging Set-Banner/API-key failures.
gpu-banner-watcher.log
